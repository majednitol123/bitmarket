

# Server Network Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=*

# PostgreSQL Database Connection
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agregator

# Redis Connection (Cache, Distributed Locks, Pub/Sub, Rate Limiting)
# Format: redis://[user]:[password]@[host]:[port]
REDIS_URL=redis://localhost:6379

# CoinStats Market Data API Keys
# Supports multiple comma-separated keys for automatic round-robin & fallback
COINSTATS_BASE_URL=https://openapiv1.coinstats.app
COINSTATS_API_KEY=your_coinstats_api_key_here
COINSTATS_API_KEYS=your_coinstats_api_key_1,your_coinstats_api_key_2

# Alchemy RPC Provider Key (for real on-chain balance & transaction queries)
ALCHEMY_API_KEY=your_alchemy_api_key_here

# Cache Time-To-Live (Seconds)
CACHE_TTL_OVERVIEW=30
CACHE_TTL_TOKENS=30
CACHE_TTL_PRICE=15
CACHE_TTL_CHART=300
CACHE_TTL_SEARCH=60
CACHE_TTL_PORTFOLIO=30
CACHE_TTL_HOLDINGS=30
CACHE_TTL_PORTFOLIO_CHART=120
CACHE_TTL_TRANSACTIONS=60
CACHE_TTL_DEFI=120

# Rate Limiting Thresholds (Requests per 60-second window)
RATE_LIMIT_GLOBAL_MAX=120
RATE_LIMIT_REFRESH_MAX=15
RATE_LIMIT_MUTATION_MAX=30
