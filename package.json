{
  "name": "bitmarket",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "NODE_OPTIONS='--no-experimental-strip-types' expo start -c",
    "android": "node scripts/fix-android-build.js && NODE_OPTIONS='--no-experimental-strip-types' expo run:android",
    "ios": "node scripts/fix-ios-splash.js && NODE_OPTIONS='--no-experimental-strip-types' expo run:ios",
    "web": "NODE_OPTIONS='--no-experimental-strip-types' expo start --web -c",
    "prebuild": "expo prebuild",
    "postprebuild": "node scripts/fix-ios-splash.js && node scripts/fix-android-build.js",
    "redux-devtools": "redux-devtools --open=electron --hostname=localhost --port=8000",
    "test": "NODE_OPTIONS='--no-experimental-strip-types' jest --watchAll",
    "postinstall": "patch-package"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|@reduxjs/toolkit|immer|@solana)"
    ]
  },
